@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">@L["Error."]</h1>
<h2 class="text-danger">@L["An error occurred while processing your request."]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@L["Request ID:"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@L["Development Mode"]</h3>
<p>
    @L["Development mode displays detailed information about the error."]
</p>
<p>
    <strong>@L["Do not enable Development in a deployed application. It may reveal sensitive exception details."]</strong>
    @L["For local debugging, set ASPNETCORE_ENVIRONMENT to Development and restart the app."]
</p>
