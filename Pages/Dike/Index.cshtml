@page
@model DATA_EXCHANGE_HUB.Pages.Dike.IndexModel
@{
    ViewData["Title"] = "DIKE";
    var activePane = string.IsNullOrWhiteSpace(Model.ActivePane) ? "agreements" : Model.ActivePane;
    var agreementPane = string.IsNullOrWhiteSpace(Model.AgreementPane) ? "active" : Model.AgreementPane;
}

<div class="container-fluid exchange-page dike-page pt-4">
    <div class="row g-4 align-items-start">
        <aside class="col-xxl-2 col-xl-2 col-lg-3 mb-4 exchange-sidebar">
            <div class="p-4 mb-3 exchange-panel">
                <h3 class="mb-0 d-flex justify-content-between align-items-center fw-bold text-dark-green">
                    DIKE <small class="badge bg-secondary ms-2">DK</small>
                </h3>
                <p class="mb-0 text-dark-green">Klientu suderinimu registras.</p>
            </div>

            <div class="access-panel stacked mb-3">
                <div>
                    <span class="field-label">Registras</span>
                    <strong>Config</strong>
                </div>
                <div>
                    <span class="field-label">Saltinis</span>
                    <strong>STAT3</strong>
                </div>
                <div>
                    <span class="field-label">Audit</span>
                    <strong>Log</strong>
                </div>
            </div>

            <a class="btn btn-orange w-100" asp-page="/Hub/Index">Grizti i HUB</a>
        </aside>

        <section class="col-xxl-10 col-xl-10 col-lg-9 exchange-content">
            <div class="hub-hero mb-4">
                <div>
                    <span class="hub-eyebrow">DERINIMAI, INFORMACIJA, KONTAKTAI, ESAMI SUSITARIMAI</span>
                    <h1>DIKE</h1>
                    <p>DIKE - klientu suderinimu, kontaktu, sutartu salygu ir pakeitimu istorijos valdymo erdve.</p>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-warning mb-3" role="alert">@Model.ErrorMessage</div>
            }

            <section class="hub-board mb-4" id="dike-register">
                <div class="section-title-row">
                    <div>
                        <span class="hub-eyebrow">REGISTRAS</span>
                        <h2>Klientu suderinimu konfiguracija</h2>
                    </div>
                    <span class="status-pill-muted">CLIENT_RECONCILIATION_CONFIG</span>
                </div>

                <div class="hub-app-grid" role="tablist" aria-label="DIKE sritys">
                    <button class="app-tile @(activePane == "agreements" ? "is-selected" : "")" type="button" data-dike-tab="agreements" role="tab" aria-selected="@(activePane == "agreements" ? "true" : "false")">
                        <span class="app-tile-icon">D</span>
                        <span class="app-tile-body">
                            <span class="app-tile-title">Derinimai</span>
                            <span class="app-tile-desc">Daznis, sutartas procentas ir srautas.</span>
                        </span>
                        <span class="app-status">Config</span>
                    </button>
                    <button class="app-tile @(activePane == "info" ? "is-selected" : "")" type="button" data-dike-tab="info" role="tab" aria-selected="@(activePane == "info" ? "true" : "false")">
                        <span class="app-tile-icon">I</span>
                        <span class="app-tile-body">
                            <span class="app-tile-title">Informacija</span>
                            <span class="app-tile-desc">STAT3 klientas pagal OWNER.ID.</span>
                        </span>
                        <span class="app-status">STAT3</span>
                    </button>
                    <button class="app-tile @(activePane == "contacts" ? "is-selected" : "")" type="button" data-dike-tab="contacts" role="tab" aria-selected="@(activePane == "contacts" ? "true" : "false")">
                        <span class="app-tile-icon">K</span>
                        <span class="app-tile-body">
                            <span class="app-tile-title">Kontaktai</span>
                            <span class="app-tile-desc">Derinimo ir judejimo informavimo adresatai.</span>
                        </span>
                        <span class="app-status">Mail</span>
                    </button>
                    <button class="app-tile @(activePane == "history" ? "is-selected" : "")" type="button" data-dike-tab="history" role="tab" aria-selected="@(activePane == "history" ? "true" : "false")">
                        <span class="app-tile-icon">E</span>
                        <span class="app-tile-body">
                            <span class="app-tile-title">Esami susitarimai</span>
                            <span class="app-tile-desc">Aktyvumas, istorija ir pakeitimu logai.</span>
                        </span>
                        <span class="app-status">Audit</span>
                    </button>
                </div>
            </section>

            <section class="tool-section mb-4" data-dike-pane="agreements" hidden="@(activePane != "agreements")">
                <div class="section-title-row">
                    <div>
                        <span class="hub-eyebrow">DERINIMAI</span>
                        <h2>Klientu derinimai</h2>
                    </div>
                    <span class="status-pill-muted">Darbo erdve</span>
                </div>

                <ul class="nav nav-tabs argus-main-tabs mb-3" role="tablist" aria-label="DIKE derinimu sritys">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(agreementPane == "active" ? "active" : "")" type="button" data-dike-agreement-tab="active" role="tab" aria-selected="@(agreementPane == "active" ? "true" : "false")">
                            Artejantys / aktyvus derinimai
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @(agreementPane == "edit" ? "active" : "")" type="button" data-dike-agreement-tab="edit" role="tab" aria-selected="@(agreementPane == "edit" ? "true" : "false")">
                            Naujo sukurimas / koregavimas
                        </button>
                    </li>
                </ul>

                <div data-dike-agreement-pane="active" hidden="@(agreementPane != "active")">
                    <div class="alert alert-info mb-3" role="status">
                        Cia bus rodomi klientai, kuriems arteja arba jau aktyvus derinimo laikotarpis.
                        Senus likucius ir siuntimo istorija galesime uzkrauti is pradiniu duomenu, o veliau pildysime is web platformos veiksmu.
                    </div>

                    <div class="exchange-table-wrap">
                        <table class="exchange-table">
                            <thead>
                                <tr>
                                    <th>Klientas</th>
                                    <th>Imones kodas</th>
                                    <th>Derinimo daznis</th>
                                    <th>Arteja laikotarpis</th>
                                    <th>Paskutinis laikotarpis</th>
                                    <th>Suderintas likutis</th>
                                    <th>Informacija issiusta</th>
                                    <th>Busena</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="8" class="text-muted">
                                        Artejanciu derinimu sarasas bus prijungtas prie DIKE konfigracijos ir istorijos lentu.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div data-dike-agreement-pane="edit" hidden="@(agreementPane != "edit")">
                    <form method="get" class="exchange-panel p-3 mb-3">
                        <input type="hidden" name="ActivePane" value="agreements" />
                        <input type="hidden" name="AgreementPane" value="edit" />
                        <div class="row g-3 align-items-end">
                            <div class="col-xl-4 col-lg-5">
                                <label class="form-label" for="dikeAgreementClientSearch">Kliento paieska</label>
                                <input class="form-control" id="dikeAgreementClientSearch" name="SearchTerm" value="@Model.SearchTerm" type="search" placeholder="Pavadinimas, trumpinys arba imones kodas" />
                            </div>
                            <div class="col-xl-5 col-lg-5">
                                <label class="form-label" for="dikeAgreementClient">Klientas</label>
                                <select class="form-select" id="dikeAgreementClient" asp-for="SelectedOwnerId">
                                    <option value="">Pasirinkite klienta</option>
                                    @foreach (var client in Model.Clients)
                                    {
                                        <option value="@client.OwnerId">
                                            @client.ShortName - @client.Name (@client.RegCode)
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-xl-3 col-lg-2 d-flex justify-content-lg-end">
                                <button class="btn btn-outline-success" type="submit">Pasirinkti</button>
                            </div>
                        </div>
                    </form>

                    @if (Model.SelectedClient is null)
                    {
                        <div class="alert alert-warning mb-3" role="status">
                            Pirmiausia suraskite arba pasirinkite klienta is STAT3 leidziamu klientu saraso. Jei paieska randa viena klienta, jis pasirenkamas automatiskai; jei randa kelis, pasirinkite konkretu is saraso.
                        </div>
                    }
                    else
                    {
                        <div class="exchange-panel p-3 mb-3">
                            <div class="row g-3">
                                <div class="col-xl-2 col-md-4">
                                    <span class="field-label">SHORTNAME</span>
                                    <strong>@Model.SelectedClient.ShortName</strong>
                                </div>
                                <div class="col-xl-3 col-md-4">
                                    <span class="field-label">REGCODE</span>
                                    <strong>@Model.SelectedClient.RegCode</strong>
                                </div>
                                <div class="col-xl-5 col-md-12">
                                    <span class="field-label">NAME</span>
                                    <strong>@Model.SelectedClient.Name</strong>
                                </div>
                                <div class="col-12">
                                    <span class="field-label">ADDRESS</span>
                                    <strong>@(string.IsNullOrWhiteSpace(Model.SelectedClient.Address) ? "-" : Model.SelectedClient.Address)</strong>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-xl-6 col-md-6">
                            <label class="form-label" for="dikeContractNo">Pagal sutarti</label>
                            <input class="form-control" id="dikeContractNo" placeholder="Sutarties numeris arba pavadinimas" disabled="@(Model.SelectedClient is null)" />
                        </div>
                        <div class="col-xl-6 col-md-6">
                            <label class="form-label" for="dikeContractAppendix">Pagal sutarties prieda</label>
                            <input class="form-control" id="dikeContractAppendix" placeholder="Priedas, punktas arba papildomas tekstas" disabled="@(Model.SelectedClient is null)" />
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <label class="form-label" for="dikeFrequency">Daznis</label>
                            <select class="form-select" id="dikeFrequency" disabled="@(Model.SelectedClient is null)">
                                <option>Kas menesi</option>
                                <option>Kas ketvirti</option>
                                <option>Pagal poreiki</option>
                            </select>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <label class="form-label" for="dikeFlow">Srautas pagal kuri skaiciuosime</label>
                            <select class="form-select" id="dikeFlow" disabled="@(Model.SelectedClient is null)">
                                <option value="IN">IN</option>
                                <option value="OUT">OUT</option>
                            </select>
                        </div>
                        <div class="col-xl-3 col-md-6">
                            <label class="form-label" for="dikeWriteOffPercent">Sutartas nurasymu % pagal kuri skaiciuosim nurasoma kieki</label>
                            <input class="form-control" id="dikeWriteOffPercent" type="number" min="0" max="100" step="0.01" placeholder="0.00" disabled="@(Model.SelectedClient is null)" />
                        </div>
                        <div class="col-xl-6 col-md-12">
                            <label class="form-label" for="dikeInfPrekCode">Derinami INF_PREK kodai</label>
                            <div class="input-group">
                                <input class="form-control" id="dikeInfPrekCode" placeholder="INF_PREK kodas" disabled="@(Model.SelectedClient is null)" />
                                <button class="btn btn-outline-success" type="button" id="dikeAddInfPrekCode" disabled="@(Model.SelectedClient is null)">Prideti</button>
                            </div>
                            <div class="dike-code-list mt-2" id="dikeInfPrekCodeList" aria-live="polite">
                                <span class="text-muted small" data-empty-inf-prek>Kodu dar neprideta.</span>
                            </div>
                        </div>
                        <div class="col-xl-4 col-md-6">
                            <label class="form-label" for="dikeAgreementStart">Galioja nuo</label>
                            <input class="form-control" id="dikeAgreementStart" type="date" lang="en-CA" disabled="@(Model.SelectedClient is null)" />
                        </div>
                        <div class="col-xl-4 col-md-6">
                            <label class="form-label" for="dikeNextPeriod">Kitas derinimo laikotarpis</label>
                            <input class="form-control" id="dikeNextPeriod" type="month" lang="en-CA" disabled="@(Model.SelectedClient is null)" />
                        </div>
                        <div class="col-xl-4 col-md-12 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" id="dikeAgreementActive" type="checkbox" checked disabled="@(Model.SelectedClient is null)" />
                                <label class="form-check-label" for="dikeAgreementActive">Aktyvus susitarimas</label>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="tool-section mb-4" id="dike-client-info" data-dike-pane="info" hidden="@(activePane != "info")">
                <div class="section-title-row">
                    <div>
                        <span class="hub-eyebrow">STAT3 OWNER / ORGALL</span>
                        <h2>Kliento informacija</h2>
                    </div>
                    <span class="status-pill">Gyvas saltinis</span>
                </div>

                <div class="alert alert-info mb-3" role="status">
                    Klientas bus pasirenkamas tik is aktyviu STAT3 irasu: <strong>OWNER.ACTIVE = 1</strong>,
                    Lietuvai priskirta STAT3 klientu sriti. Sisteminiai laukai bus siejami pagal vidini kliento ID,
                    todel pasikeitus pavadinimui, kodui ar adresui STAT3, DIKE rodys nauja reiksme.
                </div>

                @if (Model.SelectedClient is not null)
                {
                    <div class="exchange-panel p-3 mb-3">
                        <div class="row g-3">
                            <div class="col-xl-2 col-md-4">
                                <span class="field-label">SHORTNAME</span>
                                <strong>@Model.SelectedClient.ShortName</strong>
                            </div>
                            <div class="col-xl-3 col-md-4">
                                <span class="field-label">REGCODE</span>
                                <strong>@Model.SelectedClient.RegCode</strong>
                            </div>
                            <div class="col-xl-5 col-md-12">
                                <span class="field-label">NAME</span>
                                <strong>@Model.SelectedClient.Name</strong>
                            </div>
                            <div class="col-12">
                                <span class="field-label">ADDRESS</span>
                                <strong>@(string.IsNullOrWhiteSpace(Model.SelectedClient.Address) ? "-" : Model.SelectedClient.Address)</strong>
                            </div>
                        </div>
                    </div>
                }

                <form method="get" class="row g-3 align-items-end mb-3">
                    <input type="hidden" name="ActivePane" value="info" />
                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <label class="form-label" for="dikeOwnerSearch">Paieska</label>
                        <input class="form-control" id="dikeOwnerSearch" name="SearchTerm" value="@Model.SearchTerm" type="search" placeholder="Pavadinimas, trumpinys arba imones kodas" />
                    </div>
                    <div class="col-xl-9 col-lg-8 col-md-6 d-flex justify-content-lg-end">
                        <button class="btn btn-outline-success" type="submit">Ieskoti</button>
                    </div>
                </form>

                <div class="exchange-table-wrap">
                    <table class="exchange-table">
                        <thead>
                            <tr>
                                <th>SHORTNAME</th>
                                <th>NAME</th>
                                <th>REGCODE</th>
                                <th>ADDRESS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Clients.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-muted">
                                        Klientu pagal nurodyta paieska nerasta.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var client in Model.Clients)
                                {
                                    <tr class="@(Model.SelectedOwnerId == client.OwnerId ? "is-selected" : "")" data-row-link>
                                        <td>
                                            <a asp-page="/Dike/Index"
                                               asp-route-ActivePane="info"
                                               asp-route-SearchTerm="@Model.SearchTerm"
                                               asp-route-SelectedOwnerId="@client.OwnerId">
                                                @client.ShortName
                                            </a>
                                        </td>
                                        <td>@client.Name</td>
                                        <td>@client.RegCode</td>
                                        <td>@client.Address</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="tool-section mb-4" data-dike-pane="contacts" hidden="@(activePane != "contacts")">
                <div class="section-title-row">
                    <div>
                        <span class="hub-eyebrow">KONTAKTAI</span>
                        <h2>Derinimo ir informavimo adresatai</h2>
                    </div>
                    <span class="status-pill-muted">Ruosiamas</span>
                </div>

                <div class="row g-3">
                    <div class="col-xl-6">
                        <label class="form-label" for="dikeReconciliationEmail">Kliento derinimo email</label>
                        <input class="form-control" id="dikeReconciliationEmail" type="email" placeholder="client@example.com" />
                    </div>
                    <div class="col-xl-6">
                        <label class="form-label" for="dikeMovementEmail">Kam siusti prekiu judejima</label>
                        <input class="form-control" id="dikeMovementEmail" type="text" placeholder="email1@example.com; email2@example.com" />
                    </div>
                </div>
            </section>

            <section class="tool-section mb-4" data-dike-pane="history" hidden="@(activePane != "history")">
                <div class="section-title-row">
                    <div>
                        <span class="hub-eyebrow">ESAMI SUSITARIMAI</span>
                        <h2>Aktyvumas ir pakeitimu istorija</h2>
                    </div>
                    <span class="status-pill-muted">CLIENT_RECONCILIATION_LOG</span>
                </div>

                <div class="exchange-table-wrap">
                    <table class="exchange-table">
                        <thead>
                            <tr>
                                <th>Laikas</th>
                                <th>Veiksmas</th>
                                <th>Vartotojas</th>
                                <th>Klientas</th>
                                <th>Pastaba</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="5" class="text-muted">Pakeitimu istorija bus prijungta prie DIKE log lentos.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const tabs = Array.from(document.querySelectorAll("[data-dike-tab]"));
            const panes = Array.from(document.querySelectorAll("[data-dike-pane]"));

            function activate(tabName) {
                tabs.forEach(tab => {
                    const isActive = tab.dataset.dikeTab === tabName;
                    tab.classList.toggle("is-selected", isActive);
                    tab.setAttribute("aria-selected", isActive ? "true" : "false");
                });

                panes.forEach(pane => {
                    pane.hidden = pane.dataset.dikePane !== tabName;
                });
            }

            tabs.forEach(tab => {
                tab.addEventListener("click", () => activate(tab.dataset.dikeTab));
            });

            const agreementTabs = Array.from(document.querySelectorAll("[data-dike-agreement-tab]"));
            const agreementPanes = Array.from(document.querySelectorAll("[data-dike-agreement-pane]"));

            function activateAgreement(tabName) {
                agreementTabs.forEach(tab => {
                    const isActive = tab.dataset.dikeAgreementTab === tabName;
                    tab.classList.toggle("active", isActive);
                    tab.setAttribute("aria-selected", isActive ? "true" : "false");
                });

                agreementPanes.forEach(pane => {
                    pane.hidden = pane.dataset.dikeAgreementPane !== tabName;
                });
            }

            agreementTabs.forEach(tab => {
                tab.addEventListener("click", () => activateAgreement(tab.dataset.dikeAgreementTab));
            });

            const infPrekInput = document.getElementById("dikeInfPrekCode");
            const addInfPrekButton = document.getElementById("dikeAddInfPrekCode");
            const infPrekList = document.getElementById("dikeInfPrekCodeList");

            function refreshInfPrekEmptyState() {
                const emptyState = infPrekList?.querySelector("[data-empty-inf-prek]");
                if (!emptyState) {
                    return;
                }

                const hasCodes = Boolean(infPrekList.querySelector("[data-inf-prek-code]"));
                emptyState.hidden = hasCodes;
            }

            function addInfPrekCode() {
                if (!infPrekInput || !infPrekList) {
                    return;
                }

                const code = infPrekInput.value.trim();
                if (!code) {
                    infPrekInput.focus();
                    return;
                }

                const normalizedCode = code.toUpperCase();
                const exists = Array.from(infPrekList.querySelectorAll("[data-inf-prek-code]"))
                    .some(item => item.dataset.infPrekCode === normalizedCode);
                if (exists) {
                    infPrekInput.value = "";
                    infPrekInput.focus();
                    return;
                }

                const item = document.createElement("span");
                item.className = "dike-code-chip";
                item.dataset.infPrekCode = normalizedCode;

                const value = document.createElement("input");
                value.type = "hidden";
                value.name = "InfPrekCodes";
                value.value = normalizedCode;

                const label = document.createElement("span");
                label.textContent = normalizedCode;

                const remove = document.createElement("button");
                remove.type = "button";
                remove.className = "dike-code-remove";
                remove.setAttribute("aria-label", `Salinti INF_PREK ${normalizedCode}`);
                remove.textContent = "x";
                remove.addEventListener("click", () => {
                    item.remove();
                    refreshInfPrekEmptyState();
                });

                item.append(value, label, remove);
                infPrekList.append(item);
                infPrekInput.value = "";
                infPrekInput.focus();
                refreshInfPrekEmptyState();
            }

            addInfPrekButton?.addEventListener("click", addInfPrekCode);
            infPrekInput?.addEventListener("keydown", event => {
                if (event.key === "Enter") {
                    event.preventDefault();
                    addInfPrekCode();
                }
            });

            document.querySelectorAll("[data-row-link]").forEach(row => {
                row.addEventListener("click", event => {
                    if (event.target.closest("a, button, input, select, textarea")) {
                        return;
                    }

                    row.querySelector("a")?.click();
                });
            });
        })();
    </script>
}
