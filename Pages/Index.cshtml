@page
@model IndexModel
@{
    ViewData["Title"] = "Data Exchange Hub";
}

<div class="container-fluid hub-page pt-4">
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <div class="hub-hero mb-4">
        <div>
            <span class="hub-eyebrow">@L["Landing.Eyebrow"]</span>
            <h1>Data Exchange Hub</h1>
            <p>@L["Landing.HeroText"]</p>
        </div>
        <a class="btn btn-orange hub-hero-action" asp-page="/Hub/Login">@L["Landing.LoginToHub"]</a>
    </div>

    <div class="row g-4 align-items-start">
        <aside class="col-xxl-3 col-xl-3 col-lg-4 hub-sidebar">
            <section class="hub-board mb-4">
                <div class="section-title-row">
                    <h2>@L["Landing.AccessRequest"]</h2>
                </div>
                <div class="alert alert-info py-2 px-3 small" role="status">
                    @Model.AuthorizationNotice
                </div>
                <form method="post" class="d-grid gap-3">
                    <div>
                        <label class="form-label" asp-for="DomainUser">@L["Landing.WindowsUser"]</label>
                        <input class="form-control" asp-for="DomainUser" readonly="@Model.IsDomainUserResolved" />
                    </div>
                    <div>
                        <label class="form-label" asp-for="AppName">@L["Common.Application"]</label>
                        <select class="form-select" asp-for="AppName">
                            @foreach (var appName in Model.RequestableApps)
                            {
                                <option value="@appName">@appName</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label" asp-for="RequestedAccess">@L["Landing.AccessType"]</label>
                        <select class="form-select" asp-for="RequestedAccess">
                            <option value="USER">USER</option>
                            <option value="ADMIN">ADMIN</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label" asp-for="Comment">@L["Landing.Comment"]</label>
                        <textarea class="form-control" asp-for="Comment" rows="4" maxlength="1000"></textarea>
                    </div>
                    <button class="btn btn-orange" type="submit">@L["Landing.SubmitRequest"]</button>
                </form>
            </section>
        </aside>

        <section class="col-xxl-9 col-xl-9 col-lg-8">
            <div class="hub-metrics mb-4">
                <div class="metric-card">
                    <small>@L["Landing.Metric.Access"]</small>
                    <h4>@L["Landing.Metric.DomainUsers"]</h4>
                </div>
                <div class="metric-card">
                    <small>@L["Landing.Metric.Workspace"]</small>
                    <h4>@L["Landing.Metric.HubPermissions"]</h4>
                </div>
                <div class="metric-card">
                    <small>@L["Landing.Metric.Version"]</small>
                    <h4>v7.1</h4>
                </div>
            </div>

            <section class="hub-board mb-4 public-feedback" id="feedback">
                <div class="section-title-row">
                    <div>
                        <span class="hub-eyebrow">@L["Landing.Feedback.Eyebrow"]</span>
                        <h2>@L["Landing.Feedback.Title"]</h2>
                    </div>
                    <span class="status-pill">@Model.ActiveSurveys.Count @L["Landing.Feedback.ActiveSurveysShort"]</span>
                </div>
                <p class="public-feedback-intro">@L["Landing.Feedback.Description"]</p>
                <div class="alert alert-info py-2 px-3 small" role="status">
                    Dalyvaujant apklausoje ar balsavime bus paprasyta Windows autorizacijos, kad atsakymas butu priskirtas jusu domeno vartotojui.
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.FeedbackSuccessMessage))
                {
                    <div class="alert alert-success" role="alert">@Model.FeedbackSuccessMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.FeedbackErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">@Model.FeedbackErrorMessage</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.PublicFeedbackLoadError))
                {
                    <div class="alert alert-warning" role="alert">@Model.PublicFeedbackLoadError</div>
                }

                <div class="public-feedback-grid">
                    <article class="public-feedback-panel">
                        <div class="section-title-row compact">
                            <h3>@L["Landing.Feedback.Surveys"]</h3>
                            <span class="status-pill-muted">@Model.ActiveSurveys.Count</span>
                        </div>
                        @if (Model.ActiveSurveys.Count == 0)
                        {
                            <div class="empty-state compact">@L["Spinkx.NoSurveys"]</div>
                        }
                        else
                        {
                            <div class="public-survey-list">
                                @foreach (var survey in Model.ActiveSurveys.Take(3))
                                {
                                    <a class="public-survey-row" asp-page="/Spinkx/Survey" asp-route-id="@survey.Id">
                                        <span>
                                            <strong>@survey.Title</strong>
                                            @if (!string.IsNullOrWhiteSpace(survey.Description))
                                            {
                                                <small>@survey.Description</small>
                                            }
                                            <small>@(survey.IsAnonymous ? "Anonimine apklausa" : "Neanonimine apklausa")</small>
                                        </span>
                                        <span class="status-pill-muted">@survey.ResponseCount</span>
                                    </a>
                                }
                            </div>
                            <a class="btn btn-sm btn-outline-success mt-3" asp-page="/Spinkx/Index">
                                @L["Landing.Feedback.AllSurveys"]
                            </a>
                        }
                    </article>

                    <article class="public-feedback-panel">
                        <h3>@L["Landing.Feedback.SuggestionTitle"]</h3>
                        <form method="post" asp-page-handler="Suggestion" class="d-grid gap-2">
                            <textarea class="form-control" asp-for="SuggestionMessage" rows="4" maxlength="2000"
                                      placeholder="@L["Landing.Feedback.SuggestionPlaceholder"]"></textarea>
                            <button class="btn btn-orange" type="submit">@L["Landing.Feedback.SendSuggestion"]</button>
                        </form>
                    </article>

                    <article class="public-feedback-panel">
                        <div class="section-title-row compact">
                            <h3>@L["Landing.Feedback.QuickPoll"]</h3>
                            <span class="status-pill-muted">@Model.QuickPolls.Count</span>
                        </div>
                        @if (Model.QuickPoll is null)
                        {
                            <div class="empty-state compact">@L["Landing.Feedback.PollUnavailable"]</div>
                        }
                        else
                        {
                            @if (Model.QuickPolls.Count > 1)
                            {
                                <div class="quick-poll-nav">
                                    <a class="btn btn-sm btn-outline-success" asp-page="/Index" asp-fragment="feedback" asp-route-poll="@Model.PreviousQuickPollId">&lsaquo;</a>
                                    <span>@(Model.QuickPollIndex + 1) / @Model.QuickPolls.Count</span>
                                    <a class="btn btn-sm btn-outline-success" asp-page="/Index" asp-fragment="feedback" asp-route-poll="@Model.NextQuickPollId">&rsaquo;</a>
                                </div>
                            }
                            <form method="post" asp-page-handler="QuickPoll" class="quick-poll-form">
                                @{
                                    var pollQuestion = Model.QuickPoll.TopLevelQuestions.FirstOrDefault();
                                    var totalVotes = Model.QuickPollResults.Values.Sum();
                                }
                                <input type="hidden" asp-for="QuickPollId" value="@Model.QuickPoll.Survey.Id" />
                                <div class="quick-poll-meta">
                                    <span>@Model.QuickPoll.Survey.Title</span>
                                    <span>@Model.QuickPoll.ResponseCount dalyvavo</span>
                                    @if (Model.QuickPoll.HasResponded)
                                    {
                                        <span>Atsakyta</span>
                                    }
                                </div>
                                <p class="quick-poll-question">@(pollQuestion?.Text ?? Model.QuickPoll.Survey.Title)</p>
                                @if (!string.IsNullOrWhiteSpace(Model.QuickPoll.Survey.Description))
                                {
                                    <small class="text-muted">@Model.QuickPoll.Survey.Description</small>
                                }
                                <div class="alert alert-info py-2 px-3 small mb-2" role="status">
                                    @(Model.QuickPoll.Survey.IsAnonymous
                                        ? "Anoniminis balsavimas: rezultatuose respondentas bus nuasmenintas."
                                        : "Neanoniminis balsavimas: atsakymas bus siejamas su vartotojo identifikatoriumi.")
                                </div>
                                @foreach (var option in pollQuestion?.Options ?? [])
                                {
                                    var voteCount = Model.QuickPollResults.TryGetValue(option.Id, out var count) ? count : 0;
                                    var percentage = totalVotes <= 0 ? 0 : (int)Math.Round(voteCount * 100m / totalVotes);
                                    <label class="quick-poll-option">
                                        <span class="quick-poll-choice">
                                            <input type="radio" asp-for="QuickPollOption" value="@option.Id" />
                                            <span>@option.Text</span>
                                        </span>
                                        <span class="quick-poll-result">
                                            <span style="width: @percentage%"></span>
                                        </span>
                                        <small>@percentage% &middot; @voteCount</small>
                                    </label>
                                }
                                <button class="btn btn-sm btn-orange" type="submit">
                                    @(Model.QuickPoll.HasResponded ? L["Landing.Feedback.UpdateVote"] : L["Landing.Feedback.Vote"])
                                </button>
                            </form>
                        }
                    </article>
                </div>
            </section>

            <section class="hub-board mb-4">
                <div class="section-title-row">
                    <h2>@L["Landing.KnowledgeSectors"]</h2>
                </div>
                <div class="hub-app-grid">
                    <a class="app-tile" href="#logistics-models" data-knowledge-trigger="logistics-models">
                        <span class="app-tile-icon">LM</span>
                        <span class="app-tile-body">
                            <span class="app-tile-title">@L["Landing.LogisticsModels"]</span>
                            <span class="app-tile-desc">@L["Landing.Sector.LogisticsModels"]</span>
                        </span>
                    </a>
                    <a class="app-tile" href="#transport" data-knowledge-trigger="transport">
                        <span class="app-tile-icon">TR</span>
                        <span class="app-tile-body">
                            <span class="app-tile-title">@L["Landing.Transport"]</span>
                            <span class="app-tile-desc">@L["Landing.Sector.Transport"]</span>
                        </span>
                    </a>
                    <a class="app-tile" href="#distribution-model" data-knowledge-trigger="distribution-model">
                        <span class="app-tile-icon">DS</span>
                        <span class="app-tile-body">
                            <span class="app-tile-title">@L["Landing.DistributionModel"]</span>
                            <span class="app-tile-desc">@L["Landing.Sector.DistributionModel"]</span>
                        </span>
                    </a>
                    <a class="app-tile" href="#warehousing" data-knowledge-trigger="warehousing">
                        <span class="app-tile-icon">WH</span>
                        <span class="app-tile-body">
                            <span class="app-tile-title">@L["Landing.Warehousing"]</span>
                            <span class="app-tile-desc">@L["Landing.Sector.Warehousing"]</span>
                        </span>
                    </a>
                    <a class="app-tile" href="#packing" data-knowledge-trigger="packing">
                        <span class="app-tile-icon">PK</span>
                        <span class="app-tile-body">
                            <span class="app-tile-title">@L["Landing.Packing"]</span>
                            <span class="app-tile-desc">@L["Landing.Sector.Packing"]</span>
                        </span>
                    </a>
                    <a class="app-tile" href="#glossary" data-knowledge-trigger="glossary">
                        <span class="app-tile-icon">AZ</span>
                        <span class="app-tile-body">
                            <span class="app-tile-title">@L["Landing.Glossary"]</span>
                            <span class="app-tile-desc">@L["Landing.Sector.Glossary"]</span>
                        </span>
                    </a>
                    <a class="app-tile" href="#kpi" data-knowledge-trigger="kpi">
                        <span class="app-tile-icon">K</span>
                        <span class="app-tile-body">
                            <span class="app-tile-title">@L["Landing.Kpi"]</span>
                            <span class="app-tile-desc">@L["Landing.Sector.Kpi"]</span>
                        </span>
                    </a>
                    <a class="app-tile" asp-page="/ClientInfo/Index">
                        <span class="app-tile-icon">CI</span>
                        <span class="app-tile-body">
                            <span class="app-tile-title">Klientu info</span>
                            <span class="app-tile-desc">Paieska pagal FIRMID is STAT3 klientu informacijos.</span>
                        </span>
                    </a>
                </div>
            </section>

            <div class="empty-state mb-4" data-knowledge-empty>
                @L["Landing.KnowledgeEmpty"]
            </div>

            <section class="hub-board mb-4 knowledge-detail" id="logistics-models" data-knowledge-section="logistics-models">
                <div class="section-title-row">
                    <h2>@L["Landing.LogisticsModels"]</h2>
                </div>
                <div class="hub-app-grid">
                    <article class="metric-card">
                        <span class="app-tile-body">
                            <span class="app-tile-title">1PL</span>
                            <span class="app-tile-desc">@L["Landing.Logistics.1PL"]</span>
                        </span>
                    </article>
                    <article class="metric-card">
                        <span class="app-tile-body">
                            <span class="app-tile-title">2PL</span>
                            <span class="app-tile-desc">@L["Landing.Logistics.2PL"]</span>
                        </span>
                    </article>
                    <article class="metric-card">
                        <span class="app-tile-body">
                            <span class="app-tile-title">3PL</span>
                            <span class="app-tile-desc">@L["Landing.Logistics.3PL"]</span>
                        </span>
                    </article>
                    <article class="metric-card">
                        <span class="app-tile-body">
                            <span class="app-tile-title">4PL</span>
                            <span class="app-tile-desc">@L["Landing.Logistics.4PL"]</span>
                        </span>
                    </article>
                </div>
            </section>

            <section class="hub-board mb-4 knowledge-detail" id="transport" data-knowledge-section="transport">
                <div class="section-title-row">
                    <h2>@L["Landing.Transport"]</h2>
                </div>
                <div class="hub-app-grid">
                    <article class="metric-card">
                        <small>JUMBO</small>
                        <img class="vehicle-icon" src="~/icons/transport/jumbo.svg" alt="" aria-hidden="true" />
                        <h4>@L["Landing.Transport.Jumbo.Title"]</h4>
                        <span class="text-muted">@L["Landing.Transport.Jumbo.Body"]</span>
                    </article>
                    <article class="metric-card">
                        <small>TILT</small>
                        <img class="vehicle-icon" src="~/icons/transport/tilt.svg" alt="" aria-hidden="true" />
                        <h4>@L["Landing.Transport.Tilt.Title"]</h4>
                        <span class="text-muted">@L["Landing.Transport.Tilt.Body"]</span>
                    </article>
                    <article class="metric-card">
                        <small>MULTITEMP</small>
                        <img class="vehicle-icon" src="~/icons/transport/multitemp.svg" alt="" aria-hidden="true" />
                        <h4>@L["Landing.Transport.Multitemp.Title"]</h4>
                        <span class="text-muted">@L["Landing.Transport.Multitemp.Body"]</span>
                    </article>
                    <article class="metric-card">
                        <small>DISTRI</small>
                        <img class="vehicle-icon" src="~/icons/transport/small-truck.svg" alt="" aria-hidden="true" />
                        <h4>@L["Landing.Transport.SmallTruck.Title"]</h4>
                        <span class="text-muted">@L["Landing.Transport.SmallTruck.Body"]</span>
                    </article>
                    <article class="metric-card">
                        <small>VAN</small>
                        <img class="vehicle-icon" src="~/icons/transport/van.svg" alt="" aria-hidden="true" />
                        <h4>@L["Landing.Transport.Van.Title"]</h4>
                        <span class="text-muted">@L["Landing.Transport.Van.Body"]</span>
                    </article>
                </div>
            </section>

