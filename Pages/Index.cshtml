            <section class="hub-board mb-4 knowledge-detail" id="warehousing" data-knowledge-section="warehousing">
                <div class="section-title-row">
                    <h2>@L["Landing.Warehousing"]</h2>
                </div>
                <div class="hub-app-grid">
                    <article class="metric-card">
                        <small>INBOUND</small>
                        <h4>@L["Landing.Warehousing.Inbound.Title"]</h4>
                        <span class="text-muted">@L["Landing.Warehousing.Inbound.Body"]</span>
                    </article>
                    <article class="metric-card">
                        <small>STORAGE</small>
                        <h4>@L["Landing.Warehousing.Storage.Title"]</h4>
