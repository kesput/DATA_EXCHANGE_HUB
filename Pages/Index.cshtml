                        <strong>@L["Landing.Warehousing.Layout.Gate"]</strong>
                        <span>@L["Landing.Warehousing.Layout.GateBody"]</span>
                    </div>
                    <div class="warehouse-zone warehouse-zone-inbound">
                        <strong>@L["Landing.Warehousing.Layout.Inbound"]</strong>
                        <span>@L["Landing.Warehousing.Layout.InboundBody"]</span>
                    </div>
                    <div class="warehouse-zone warehouse-zone-storage">
                        <strong>@L["Landing.Warehousing.Layout.Storage"]</strong>
                        <span>@L["Landing.Warehousing.Layout.StorageBody"]</span>
                    </div>
                    <div class="warehouse-zone warehouse-zone-packing">
                        <strong>@L["Landing.Warehousing.Layout.Packing"]</strong>
                        <span>@L["Landing.Warehousing.Layout.PackingBody"]</span>
                    </div>
                    <div class="warehouse-zone warehouse-zone-outbound">
                        <strong>@L["Landing.Warehousing.Layout.Outbound"]</strong>
                        <span>@L["Landing.Warehousing.Layout.OutboundBody"]</span>
                    </div>
                </div>
            </section>

            <section class="hub-board mb-4 knowledge-detail" id="packing" data-knowledge-section="packing">
                <div class="section-title-row">
                    <h2>@L["Landing.Packing"]</h2>
                </div>
                <div class="hub-app-grid">
                    <article class="metric-card">
                        <small>PACK</small>
                        <h4>@L["Landing.Packing.Service.Title"]</h4>
                        <span class="text-muted">@L["Landing.Packing.Service.Body"]</span>
                    </article>
                    <article class="metric-card">
                        <small>CONTROL</small>
                        <h4>@L["Landing.Packing.Control.Title"]</h4>
                        <span class="text-muted">@L["Landing.Packing.Control.Body"]</span>
                    </article>
                    <article class="metric-card">
                        <small>FLOW</small>
                        <h4>@L["Landing.Packing.Flow.Title"]</h4>
                        <span class="text-muted">@L["Landing.Packing.Flow.Body"]</span>
                    </article>
                </div>
            </section>

            <section class="tool-section mb-4 knowledge-detail" id="glossary" data-knowledge-section="glossary">
                <div class="section-title-row">
                    <h2>@L["Landing.Glossary"]</h2>
                    <span class="status-pill">@L["Landing.Status.Filling"]</span>
                </div>
                <div class="mb-3">
                    <input class="form-control"
                           type="search"
                           placeholder="@L["Landing.Glossary.SearchPlaceholder"]"
                           aria-label="@L["Landing.Glossary.SearchPlaceholder"]"
                           data-glossary-search />
                </div>
                <div class="glossary-list">
                    @foreach (var term in Model.GlossaryTerms)
                    {
                        <article class="glossary-row" data-glossary-term="@term.SearchText">
                            <div class="glossary-term">
                                <small>@term.Term</small>
                                <h4>@term.Title</h4>
                            </div>
                            <p class="glossary-description">@term.Description</p>
                            @if (term.Synonyms.Count > 0)
                            {
                                <div class="glossary-synonyms" aria-label="@L["Landing.Glossary.Synonyms"]">
                                    <span class="glossary-synonyms-label">@L["Landing.Glossary.Synonyms"]</span>
                                    @foreach (var synonym in term.Synonyms)
                                    {
                                        <span class="glossary-synonym">@synonym</span>
                                    }
                                </div>
                            }
                        </article>
                    }
                </div>
                <div class="empty-state compact mt-3 d-none" data-glossary-empty>
                    @L["Landing.Glossary.NoResults"]
                </div>
            </section>

            <section class="tool-section knowledge-detail" id="kpi" data-knowledge-section="kpi">
                <div class="section-title-row">
                    <h2>@L["Landing.Kpi"]</h2>
                </div>
                <div class="hub-app-grid">
                    <article class="metric-card">
                        <small>KPI</small>
                        <h4>@L["Landing.Kpi.What.Title"]</h4>
                        <span class="text-muted">@L["Landing.Kpi.What.Body"]</span>
                    </article>
                    <article class="metric-card">
                        <small>TARGET</small>
                        <h4>@L["Landing.Kpi.Target.Title"]</h4>
                        <span class="text-muted">@L["Landing.Kpi.Target.Body"]</span>
                    </article>
                    <article class="metric-card">
                        <small>ACTION</small>
                        <h4>@L["Landing.Kpi.Action.Title"]</h4>
                        <span class="text-muted">@L["Landing.Kpi.Action.Body"]</span>
                    </article>
                </div>
            </section>

        </section>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const triggers = Array.from(document.querySelectorAll("[data-knowledge-trigger]"));
            const sections = Array.from(document.querySelectorAll("[data-knowledge-section]"));
            const emptyState = document.querySelector("[data-knowledge-empty]");

            function showSection(sectionId, scrollIntoView) {
                const selected = sections.find(section => section.dataset.knowledgeSection === sectionId);
                if (!selected) {
                    sections.forEach(section => section.classList.remove("is-active"));
                    triggers.forEach(trigger => trigger.classList.remove("is-selected"));
                    emptyState?.classList.remove("d-none");
                    return;
                }

                sections.forEach(section => {
                    section.classList.toggle("is-active", section === selected);
                });
                triggers.forEach(trigger => {
                    trigger.classList.toggle("is-selected", trigger.dataset.knowledgeTrigger === sectionId);
                });
                emptyState?.classList.add("d-none");

                if (scrollIntoView) {
                    selected.scrollIntoView({ behavior: "smooth", block: "start" });
                }
            }

            triggers.forEach(trigger => {
                trigger.addEventListener("click", event => {
                    event.preventDefault();
                    const sectionId = trigger.dataset.knowledgeTrigger;
                    history.replaceState(null, "", `#${sectionId}`);
                    showSection(sectionId, true);
                });
            });

            const initialSection = window.location.hash.replace("#", "");
            showSection(initialSection, false);

            const glossarySearch = document.querySelector("[data-glossary-search]");
            const glossaryEmpty = document.querySelector("[data-glossary-empty]");
            const glossaryCards = Array.from(document.querySelectorAll("[data-glossary-term]"));

            glossarySearch?.addEventListener("input", () => {
                const query = glossarySearch.value.trim().toLocaleLowerCase();
                let visibleCount = 0;

                glossaryCards.forEach(card => {
                    const searchable = `${card.dataset.glossaryTerm ?? ""} ${card.textContent ?? ""}`.toLocaleLowerCase();
                    const isVisible = query.length === 0 || searchable.includes(query);
                    card.classList.toggle("d-none", !isVisible);
                    if (isVisible) {
                        visibleCount += 1;
                    }
                });

                glossaryEmpty?.classList.toggle("d-none", visibleCount > 0);
            });

            document.querySelectorAll("[data-distribution-toggle]").forEach(toggle => {
                toggle.addEventListener("change", () => {
                    const routeName = toggle.dataset.distributionToggle;
                    document.querySelectorAll(`.route-${routeName}`).forEach(route => {
                        route.classList.toggle("d-none", !toggle.checked);
                    });
                });
            });

        })();
    </script>
}




