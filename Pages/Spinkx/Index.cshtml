@page
@model DATA_EXCHANGE_HUB.Pages.Spinkx.IndexModel
@{
    ViewData["Title"] = "SPINKX";
}

<div class="container-fluid hub-page pt-4">
    <div class="hub-hero mb-4">
        <div>
            <span class="hub-eyebrow">@L["Landing.Sphinx.Eyebrow"]</span>
            <h1>SPINKX</h1>
            <p>@L["Landing.Sphinx.Description"]</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger mb-4" role="alert">@Model.ErrorMessage</div>
    }

    <div class="hub-board mb-4">
        <div class="section-title-row">
            <h2>@L["Spinkx.ActiveSurveys"]</h2>
            <span class="status-pill">@Model.Surveys.Count</span>
        </div>

        @if (Model.Surveys.Count == 0)
        {
            <div class="empty-state">@L["Spinkx.NoSurveys"]</div>
        }
        else
        {
            <div class="hub-app-grid">
                @foreach (var s in Model.Surveys)
                {
                    <article class="metric-card" style="position:relative">
                        @if (s.HasResponded)
                        {
                            <span class="badge bg-success position-absolute" style="top:.6rem;right:.6rem">
                                @L["Spinkx.AlreadyFilled"]
                            </span>
                        }
                        <small>SPINKX · @s.QuestionCount @L["Spinkx.Questions"]</small>
                        <h4>@s.Title</h4>
                        @if (!string.IsNullOrWhiteSpace(s.Description))
                        {
                            <span class="text-muted d-block mb-2">@s.Description</span>
                        }
                        <div class="alert alert-info py-2 px-3 small mb-2" role="status">
                            @(s.IsAnonymous
                                ? "Anonimine apklausa: rezultatuose respondentas bus nuasmenintas."
                                : "Neanonimine apklausa: atsakymas bus siejamas su vartotojo identifikatoriumi.")
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <small class="text-muted">@s.ResponseCount
                                @if (s.MaxResponses.HasValue)
                                {
                                    <span>/ @s.MaxResponses</span>
                                }
                                @L["Spinkx.Respondents"]
                            </small>
                            @if (s.ExpiresAt.HasValue)
                            {
                                <small class="text-muted">@L["Spinkx.Until"] @s.ExpiresAt.Value.ToString("yyyy-MM-dd")</small>
                            }
                        </div>
                        <a class="btn btn-sm btn-orange mt-2 w-100" asp-page="/Spinkx/Survey" asp-route-id="@s.Id">
                            @(s.HasResponded ? L["Spinkx.EditAnswer"] : L["Spinkx.FillSurvey"])
                        </a>
                    </article>
                }
            </div>
        }
    </div>
</div>

