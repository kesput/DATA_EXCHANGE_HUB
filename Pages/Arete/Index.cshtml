@page
@model DATA_EXCHANGE_HUB.Pages.Arete.IndexModel
@{
    ViewData["Title"] = "ARETE";
}

<div class="container-fluid exchange-page arete-page pt-4">
    <div class="row g-4 align-items-start">
        <aside class="col-xxl-2 col-xl-2 col-lg-3 mb-4 exchange-sidebar">
            <div class="p-4 mb-3 exchange-panel">
                <h3 class="mb-0 d-flex justify-content-between align-items-center fw-bold text-dark-green">
                    ARETE <small class="badge bg-secondary ms-2">AR</small>
                </h3>
                <p class="mb-0 text-dark-green">@L["Arete.Subtitle"]</p>
            </div>

            <div class="hub-app-list mb-3">
                <div class="side-panel-title">@L["Arete.Pillars"]</div>
                <div class="list-group">
                    @foreach (var pillar in Model.Pillars)
                    {
                        var queries = Model.GetQueriesForArea(pillar.Area);
                        <a class="list-group-item list-group-item-action list-with-details @(pillar.Area.Equals(Model.ActiveArea, StringComparison.OrdinalIgnoreCase) ? "active is-selected" : "")"
                           asp-page="/Arete/Index"
                           asp-route-AreteArea="@pillar.Area">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <strong>@L[pillar.TitleKey]</strong>
                                <span class="text-muted small">@pillar.Letter</span>
                            </div>
                            <div class="d-flex justify-content-end align-items-center mt-1 client-kpis">
                                <div class="kpi-item text-success">
                                    <div class="fw-bold">@queries.Count</div>
                                    <small>SQL</small>
                                </div>
                                <div class="kpi-item text-success">
                                    <div class="fw-bold">@L["Arete.Status.Design"]</div>
                                    <small>@L["Common.Status"]</small>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>

            <a class="btn btn-orange w-100" asp-page="/Hub/Index">@L["Common.BackToHub"]</a>
        </aside>

        <section class="col-xxl-10 col-xl-10 col-lg-9 exchange-content">
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
            }

            <div class="hub-hero mb-4 arete-hero">
                <div>
                    <span class="hub-eyebrow">@L["Arete.Eyebrow"]</span>
                    <h1>ARETE</h1>
                    <p>@L["Arete.HeroText"]</p>
                </div>
            </div>

            <section class="hub-board mb-4">
                <div class="section-title-row">
                    <h2>@L["Arete.Pillars"]</h2>
                </div>
                <div class="hub-app-grid arete-direction-grid">
                    @foreach (var pillar in Model.Pillars)
                    {
                        var queries = Model.GetQueriesForArea(pillar.Area);
                        <a class="app-tile @(pillar.Area.Equals(Model.ActiveArea, StringComparison.OrdinalIgnoreCase) ? "is-selected" : "")"
                           asp-page="/Arete/Index"
                           asp-route-AreteArea="@pillar.Area">
                            <span class="app-tile-icon">@pillar.Letter</span>
                            <span class="app-tile-body">
                                <span class="app-tile-title">@L[pillar.TitleKey]</span>
                                <span class="app-tile-desc">@L[pillar.BodyKey]</span>
                            </span>
                            <span class="app-status">@queries.Count SQL</span>
                        </a>
                    }
                </div>
            </section>

            @foreach (var pillar in Model.Pillars.Where(pillar => pillar.Area.Equals(Model.ActiveArea, StringComparison.OrdinalIgnoreCase)))
            {
                var areaQueries = Model.GetQueriesForArea(pillar.Area);
                <section class="tool-section mb-3 arete-area-section" id="arete-@pillar.Area">
                    <div class="section-title-row">
                        <h2>@L[pillar.TitleKey]</h2>
                        <span class="status-pill">@L["Arete.Status.Design"]</span>
                    </div>

                    @if (areaQueries.Count == 0)
                    {
                        <div class="empty-state">@L["Arete.Query.Empty"]</div>
                    }
                    else
                    {
                        <form method="post" class="d-grid gap-3" id="areteQueryForm" data-busy-form data-busy-title="ARETE uzklausa vykdoma">
                            <div class="row g-3 align-items-end">
                                <div class="col-lg-8">
                                    <label class="form-label" asp-for="QueryId">@L["Arete.Query.Select"]</label>
                                    <select class="form-select" asp-for="QueryId" id="areteQuerySelect">
                                        @foreach (var query in areaQueries)
                                        {
                                            <option value="@query.Id">@query.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-lg-4 d-flex gap-2">
                                    <button type="submit" asp-page-handler="Execute" class="btn btn-orange" data-busy-label="Vykdoma...">EXECUTE</button>
                                    <button type="submit" asp-page-handler="ExportExcel" class="btn btn-outline-primary" data-busy-title="Excel failas ruosiamas" data-busy-label="Ruosiamas Excel..." data-busy-auto-reset-ms="5000">Export Excel</button>
                                    <button type="submit" asp-page-handler="ExportCsv" class="btn btn-outline-success" data-busy-title="CSV failas ruosiamas" data-busy-label="Ruosiamas CSV..." data-busy-auto-reset-ms="5000">Export CSV</button>
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.SelectedQuery?.Description))
                            {
                                <div class="alert alert-info mb-0" role="status">
                                    @Model.SelectedQuery.Description
                                </div>
                            }

                                @if (Model.QueryParameters.Count > 0 && pillar.Area.Equals(Model.ActiveArea, StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="hub-board apis-parameter-board">
                                        <div class="section-title-row compact">
                                            <h3>Parametrai</h3>
                                            <span class="status-pill-muted">SQL</span>
                                        </div>
                                        <div class="row g-3">
                                            @for (var index = 0; index < Model.QueryParameters.Count; index++)
                                            {
                                                var parameter = Model.QueryParameters[index];
                                                <div class="col-xl-4 col-md-6">
                                                    <input type="hidden" name="FilterColumns" value="@parameter.Name" />
                                                    <input type="hidden" name="FilterOperators" value="@ExchangeTableFilter.EqualsOperator" />
                                                    <input type="hidden" name="FilterConnectors" value="@ExchangeTableFilter.AndConnector" />
                                                    <label class="form-label" for="arete-param-@index">
                                                        @parameter.Name
                                                        @if (parameter.IsRequired)
                                                        {
                                                            <span class="text-danger">*</span>
                                                        }
                                                    </label>
                                                    @if (IndexModel.IsDateParameter(parameter))
                                                    {
                                                        <div class="input-group apis-date-input" data-date-format="@Model.GetDateDisplayFormat()">
                                                            <input class="form-control apis-date-display"
                                                                   id="arete-param-@index"
                                                                   name="FilterValues"
                                                                   type="text"
                                                                   inputmode="numeric"
                                                                   value="@Model.GetParameterDisplayValue(parameter)"
                                                                   placeholder="@Model.GetDateDisplayPlaceholder()"
                                                                   pattern="@IndexModel.GetParameterPattern(parameter)"
                                                                   title="@IndexModel.GetParameterTitle(parameter)"
                                                                   autocomplete="off"
                                                                   required="@(parameter.IsRequired ? "required" : null)" />
                                                            <button class="btn btn-outline-secondary apis-date-open" type="button" aria-label="Pasirinkti data">Cal</button>
                                                            <input class="apis-date-native" type="date" value="@Model.GetParameterNativeDateValue(parameter)" tabindex="-1" aria-hidden="true" />
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <input class="form-control"
                                                               id="arete-param-@index"
                                                               name="FilterValues"
                                                               type="@IndexModel.GetParameterInputType(parameter)"
                                                               inputmode="@IndexModel.GetParameterInputMode(parameter)"
                                                               value="@Model.GetParameterValue(parameter)"
                                                               placeholder="@IndexModel.GetParameterPlaceholder(parameter)"
                                                               required="@(parameter.IsRequired ? "required" : null)" />
                                                    }
                                                    <div class="form-text">@IndexModel.GetParameterDescription(parameter)</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (Model.RequiredFilterRows.Count > 0 && pillar.Area.Equals(Model.ActiveArea, StringComparison.OrdinalIgnoreCase))
                                {
                                    var requiredFilter = Model.RequiredFilterRows.FirstOrDefault();
                                    var firstFilter = Model.OptionalFilterRows.FirstOrDefault() ?? new ExchangeTableFilter(string.Empty, ExchangeTableFilter.EqualsOperator, string.Empty, ExchangeTableFilter.AndConnector);
                                    <div class="exchange-filter-row arete-first-filter-row">
                                        <div class="filter-connector">
                                            <span class="filter-connector-placeholder">WHERE</span>
                                            <input type="hidden" name="FilterConnectors" value="@ExchangeTableFilter.AndConnector" />
                                        </div>
                                        @if (requiredFilter is not null)
                                        {
                                            <input type="hidden" name="FilterColumns" value="@requiredFilter.Definition.Name" />
                                            <span class="form-control form-control-sm arete-locked-filter">@requiredFilter.Definition.Name *</span>
                                            <select name="FilterOperators" class="form-select form-select-sm" aria-label="@L["DataExchange.FilterOperator"]" data-arete-filter-operator>
                                                @foreach (var filterOperator in requiredFilter.Definition.AllowedOperators)
                                                {
                                                    <option value="@filterOperator" selected="@(requiredFilter.Operator.Equals(filterOperator, StringComparison.OrdinalIgnoreCase))">
                                                        @IndexModel.GetOperatorLabel(filterOperator)
                                                    </option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <select name="FilterColumns" class="form-select form-select-sm" aria-label="@L["DataExchange.FilterColumn"]">
                                                <option value="">@L["DataExchange.FilterColumn"]</option>
                                                @foreach (var definition in Model.FilterDefinitions)
                                                {
                                                    <option value="@definition.Name"
                                                            data-type="@definition.DataType"
                                                            data-operators="@string.Join(",", definition.AllowedOperators)"
                                                            data-description="@definition.Description"
                                                            selected="@(firstFilter.ColumnName.Equals(definition.Name, StringComparison.OrdinalIgnoreCase))">
                                                        @definition.Name
                                                    </option>
                                                }
                                            </select>
                                            <select name="FilterOperators" class="form-select form-select-sm" aria-label="@L["DataExchange.FilterOperator"]" data-arete-filter-operator>
                                                @{
                                                    var firstFilterDefinition = Model.FilterDefinitions.FirstOrDefault(definition =>
                                                        definition.Name.Equals(firstFilter.ColumnName, StringComparison.OrdinalIgnoreCase)) ??
                                                        Model.FilterDefinitions.FirstOrDefault();
                                                }
                                                @foreach (var filterOperator in firstFilterDefinition?.AllowedOperators ?? [])
                                                {
                                                    <option value="@filterOperator" selected="@(firstFilter.Operator.Equals(filterOperator, StringComparison.OrdinalIgnoreCase))">
                                                        @IndexModel.GetOperatorLabel(filterOperator)
                                                    </option>
                                                }
                                            </select>
                                        }
                                        <input class="form-control form-control-sm filter-value-input"
                                               type="@(requiredFilter is not null ? IndexModel.GetFilterInputType(requiredFilter.Definition) : "text")"
                                               inputmode="@(requiredFilter is not null ? IndexModel.GetFilterInputMode(requiredFilter.Definition) : "text")"
                                               lang="@(requiredFilter is not null ? IndexModel.GetFilterInputLanguage(requiredFilter.Definition) : string.Empty)"
                                               data-arete-filter-type="@(requiredFilter?.Definition.DataType ?? "text")"
                                               name="FilterValues"
                                               value="@(requiredFilter is not null ? IndexModel.FormatFilterInputValue(requiredFilter.Definition, requiredFilter.Value) : firstFilter.Value)"
                                               placeholder="@L["DataExchange.FilterValue"]" />
                                    </div>
                                }

                            @if (Model.FilterDefinitions.Count > 0 && pillar.Area.Equals(Model.ActiveArea, StringComparison.OrdinalIgnoreCase))
                            {
                                var requiredFilters = Model.FilterDefinitions
                                    .Where(filter => filter.IsRequired)
                                    .Select(filter => $"{filter.Name} *")
                                    .ToArray();
                                <div class="exchange-filter-form arete-filter-form">
                                    <div class="exchange-filter-header">
                                        <h3>@L["DataExchange.Filters"]</h3>
                                        @if (requiredFilters.Length > 0)
                                        {
                                            <span class="status-pill">@string.Join(", ", requiredFilters)</span>
                                        }
                                    </div>
                                    <div class="exchange-filter-rows arete-required-filter-rows">
                                        @for (var requiredIndex = 1; requiredIndex < Model.RequiredFilterRows.Count; requiredIndex++)
                                        {
                                            var requiredFilter = Model.RequiredFilterRows[requiredIndex];
                                            <div class="exchange-filter-row arete-required-filter-row">
                                                <div class="filter-connector">
                                                    <input type="hidden" name="FilterConnectors" value="@ExchangeTableFilter.AndConnector" />
                                                    <span class="filter-connector-placeholder">AND</span>
                                                </div>
                                                <input type="hidden" name="FilterColumns" value="@requiredFilter.Definition.Name" />
                                                <span class="form-control form-control-sm arete-locked-filter">@requiredFilter.Definition.Name *</span>
                                                <select name="FilterOperators" class="form-select form-select-sm" aria-label="@L["DataExchange.FilterOperator"]" data-arete-filter-operator>
                                                    @foreach (var filterOperator in requiredFilter.Definition.AllowedOperators)
                                                    {
                                                        <option value="@filterOperator" selected="@(requiredFilter.Operator.Equals(filterOperator, StringComparison.OrdinalIgnoreCase))">
                                                            @IndexModel.GetOperatorLabel(filterOperator)
                                                        </option>
                                                    }
                                                </select>
                                                <input class="form-control form-control-sm filter-value-input"
                                                       type="@IndexModel.GetFilterInputType(requiredFilter.Definition)"
                                                       inputmode="@IndexModel.GetFilterInputMode(requiredFilter.Definition)"
                                                       lang="@IndexModel.GetFilterInputLanguage(requiredFilter.Definition)"
                                                       data-arete-filter-type="@requiredFilter.Definition.DataType"
                                                       name="FilterValues"
                                                       value="@IndexModel.FormatFilterInputValue(requiredFilter.Definition, requiredFilter.Value)"
                                                       placeholder="@L["DataExchange.FilterValue"]" />
                                            </div>
                                        }
                                    </div>
                                    <div class="exchange-filter-rows" id="areteFilterRows">
                                        @{
                                            var additionalOptionalFilters = Model.OptionalFilterRows.Where(filter => filter.IsActive);
                                        }
                                        @foreach (var filter in additionalOptionalFilters)
                                        {
                                            var filterDefinition = Model.FilterDefinitions.FirstOrDefault(definition =>
                                                definition.Name.Equals(filter.ColumnName, StringComparison.OrdinalIgnoreCase)) ??
                                                Model.FilterDefinitions.FirstOrDefault(definition => !definition.IsRequired);
                                            <div class="exchange-filter-row">
                                                <div class="filter-connector">
                                                    <select name="FilterConnectors" class="form-select form-select-sm" aria-label="@L["DataExchange.FilterConnector"]">
                                                        <option value="@ExchangeTableFilter.AndConnector" selected="@(filter.Connector.Equals(ExchangeTableFilter.AndConnector, StringComparison.OrdinalIgnoreCase))">AND</option>
                                                        <option value="@ExchangeTableFilter.OrConnector" selected="@(filter.Connector.Equals(ExchangeTableFilter.OrConnector, StringComparison.OrdinalIgnoreCase))">OR</option>
                                                    </select>
                                                </div>
                                                <select name="FilterColumns" class="form-select form-select-sm" aria-label="@L["DataExchange.FilterColumn"]" data-arete-filter-column>
                                                    <option value="">@L["DataExchange.FilterColumn"]</option>
                                                    @foreach (var definition in Model.FilterDefinitions)
                                                    {
                                                        if (definition.IsRequired)
                                                        {
                                                            continue;
                                                        }
                                                        <option value="@definition.Name"
                                                                data-type="@definition.DataType"
                                                                data-operators="@string.Join(",", definition.AllowedOperators)"
                                                                data-description="@definition.Description"
                                                                selected="@(filter.ColumnName.Equals(definition.Name, StringComparison.OrdinalIgnoreCase))">
                                                            @definition.Name
                                                        </option>
                                                    }
                                                </select>
                                                <select name="FilterOperators" class="form-select form-select-sm" aria-label="@L["DataExchange.FilterOperator"]" data-arete-filter-operator>
                                                    @foreach (var filterOperator in filterDefinition?.AllowedOperators ?? [])
                                                    {
                                                        <option value="@filterOperator" selected="@(filter.Operator.Equals(filterOperator, StringComparison.OrdinalIgnoreCase))">
                                                            @IndexModel.GetOperatorLabel(filterOperator)
                                                        </option>
                                                    }
                                                </select>
                                                <input class="form-control form-control-sm filter-value-input"
                                                       type="@(Model.FilterDefinitions.FirstOrDefault(definition => definition.Name.Equals(filter.ColumnName, StringComparison.OrdinalIgnoreCase)) is { } selectedDefinition ? IndexModel.GetFilterInputType(selectedDefinition) : "text")"
                                                       inputmode="@(Model.FilterDefinitions.FirstOrDefault(definition => definition.Name.Equals(filter.ColumnName, StringComparison.OrdinalIgnoreCase)) is { } selectedInputDefinition ? IndexModel.GetFilterInputMode(selectedInputDefinition) : "text")"
                                                       lang="@(Model.FilterDefinitions.FirstOrDefault(definition => definition.Name.Equals(filter.ColumnName, StringComparison.OrdinalIgnoreCase)) is { } selectedLanguageDefinition ? IndexModel.GetFilterInputLanguage(selectedLanguageDefinition) : string.Empty)"
                                                       name="FilterValues"
                                                       value="@(Model.FilterDefinitions.FirstOrDefault(definition => definition.Name.Equals(filter.ColumnName, StringComparison.OrdinalIgnoreCase)) is { } valueDefinition ? IndexModel.FormatFilterInputValue(valueDefinition, filter.Value) : filter.Value)"
                                                       placeholder="@L["DataExchange.FilterValue"]" />
                                                <button type="button" class="btn btn-sm btn-outline-secondary filter-remove-button" data-remove-arete-filter>@L["DataExchange.ClearFilters"]</button>
                                                <div class="form-text filter-description-line" data-arete-filter-description>@(filterDefinition?.Description ?? string.Empty)</div>
                                            </div>
                                        }
                                    </div>
                                    <div class="exchange-filter-actions">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" id="addAreteFilterButton">@L["DataExchange.AddFilter"]</button>
                                    </div>
                                </div>
                            }

                        </form>

                        @if (Model.Result is not null && Model.SelectedQuery?.Area.Equals(pillar.Area, StringComparison.OrdinalIgnoreCase) == true)
                        {
                            <div class="hub-metrics my-4">
                                <div class="metric-card">
                                    <small>@L["Arete.Query.Rows"]</small>
                                    <h4>@Model.Result.Rows.Count</h4>
                                </div>
                                <div class="metric-card">
                                    <small>@L["DataExchange.ChangedColumns"]</small>
                                    <h4>@Model.Result.Columns.Count</h4>
                                </div>
                                <div class="metric-card">
                                    <small>@L["Themis.Source"]</small>
                                    <h4>@Model.SelectedQuery?.Name</h4>
                                </div>
                            </div>

                            @if (Model.HasResultPaging)
                            {
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-3" data-result-pager>
                                    <span class="status-pill">Rodoma @Model.ResultPageStartRow-@Model.ResultPageEndRow is @Model.ResultTotalRows</span>
                                    <button type="submit" form="areteQueryForm" formaction="?handler=ResultPage" name="ResultPage" value="@(Math.Max(1, Model.ResultPageValue - 1))" class="btn btn-sm btn-outline-secondary" disabled="@(Model.ResultPageValue <= 1)">Ankstesnis</button>
                                    <span class="small text-muted">Puslapis @Model.ResultPageValue / @Model.ResultTotalPages</span>
                                    <button type="submit" form="areteQueryForm" formaction="?handler=ResultPage" name="ResultPage" value="@(Math.Min(Model.ResultTotalPages, Model.ResultPageValue + 1))" class="btn btn-sm btn-outline-secondary" disabled="@(Model.ResultPageValue >= Model.ResultTotalPages)">Kitas</button>
                                </div>
                            }
                            @if (Model.Result.Rows.Count == 0)
                            {
                                <div class="empty-state">@L["DataExchange.NoData"]</div>
                            }
                            else
                            {
                                <div class="table-responsive exchange-table-wrap">
                                    <table class="table align-middle exchange-table">
                                        <thead>
                                            <tr>
                                                @foreach (var column in Model.Result.Columns)
                                                {
                                                    <th>@column</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in Model.DisplayRows)
                                            {
                                                <tr>
                                                    @foreach (var column in Model.Result.Columns)
                                                    {
                                                        <td>@(row.TryGetValue(column, out var value) ? value : string.Empty)</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    }
                </section>
            }
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const filters = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FilterDefinitions.Where(filter => !filter.IsRequired).Select(filter => new { filter.Name, filter.DataType, filter.AllowedOperators, filter.Description }) ?? []));
            const rows = document.getElementById("areteFilterRows");
            const addButton = document.getElementById("addAreteFilterButton");
            const querySelect = document.getElementById("areteQuerySelect");

            querySelect?.addEventListener("change", () => {
                const url = new URL(window.location.href);
                url.searchParams.set("QueryId", querySelect.value);
                window.location.href = url.toString();
            });

            const pad = value => String(value).padStart(2, "0");
            const formatDate = (isoValue, format) => {
                if (!/^\d{4}-\d{2}-\d{2}$/.test(isoValue)) return "";
                const [year, month, day] = isoValue.split("-");
                return format === "dd/MM/yyyy" ? `${day}/${month}/${year}` : `${year}-${month}-${day}`;
            };
            const parseDisplayDate = (value, format) => {
                const trimmed = value.trim();
                const match = format === "dd/MM/yyyy"
                    ? /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(trimmed)
                    : /^(\d{4})-(\d{2})-(\d{2})$/.exec(trimmed);
                if (!match) return "";
                const year = format === "dd/MM/yyyy" ? match[3] : match[1];
                const month = match[2];
                const day = format === "dd/MM/yyyy" ? match[1] : match[3];
                return `${year}-${pad(month)}-${pad(day)}`;
            };

            document.querySelectorAll(".apis-date-input").forEach(group => {
                const display = group.querySelector(".apis-date-display");
                const native = group.querySelector(".apis-date-native");
                const opener = group.querySelector(".apis-date-open");
                const format = group.dataset.dateFormat || "yyyy-MM-dd";
                opener?.addEventListener("click", () => {
                    native.value = parseDisplayDate(display.value, format) || native.value;
                    if (typeof native.showPicker === "function") {
                        native.showPicker();
                    } else {
                        native.click();
                    }
                });
                native?.addEventListener("change", () => {
                    display.value = formatDate(native.value, format);
                    display.dispatchEvent(new Event("input", { bubbles: true }));
                });
                display?.addEventListener("change", () => {
                    native.value = parseDisplayDate(display.value, format);
                });
            });

            if (!rows || !addButton) {
                return;
            }

            addButton.addEventListener("click", () => {
                rows.appendChild(createRow());
            });

            rows.addEventListener("click", event => {
                const button = event.target.closest("[data-remove-arete-filter]");
                if (!button) {
                    return;
                }

                button.closest(".exchange-filter-row")?.remove();
            });

            function createRow() {
                const row = document.createElement("div");
                row.className = "exchange-filter-row";

                const connectorSlot = document.createElement("div");
                connectorSlot.className = "filter-connector";
                const connectorSelect = document.createElement("select");
                connectorSelect.name = "FilterConnectors";
                connectorSelect.className = "form-select form-select-sm";
                connectorSelect.appendChild(createOption("and", "AND"));
                connectorSelect.appendChild(createOption("or", "OR"));
                connectorSlot.appendChild(connectorSelect);
                row.appendChild(connectorSlot);

                const columnSelect = document.createElement("select");
                columnSelect.name = "FilterColumns";
                columnSelect.className = "form-select form-select-sm";
                columnSelect.appendChild(createOption("", "Stulpelis"));
                filters.forEach(filter => {
                    const option = createOption(filter.name ?? filter.Name, filter.name ?? filter.Name);
                    option.dataset.type = filter.dataType ?? filter.DataType ?? "text";
                    option.dataset.operators = (filter.allowedOperators ?? filter.AllowedOperators ?? ["eq"]).join(",");
                    option.dataset.description = filter.description ?? filter.Description ?? "";
                    columnSelect.appendChild(option);
                });
                row.appendChild(columnSelect);

                const operatorSelect = document.createElement("select");
                operatorSelect.name = "FilterOperators";
                operatorSelect.className = "form-select form-select-sm";
                operatorSelect.dataset.areteFilterOperator = "";
                row.appendChild(operatorSelect);

                const valueInput = document.createElement("input");
                valueInput.name = "FilterValues";
                valueInput.className = "form-control form-control-sm filter-value-input";
                valueInput.placeholder = "Reiksme";
                row.appendChild(valueInput);

                const help = document.createElement("div");
                help.className = "form-text filter-description-line";
                help.dataset.areteFilterDescription = "";

                columnSelect.addEventListener("change", () => {
                    updateOperatorOptions(columnSelect, operatorSelect);
                    updateInputType(columnSelect, operatorSelect, valueInput);
                });
                operatorSelect.addEventListener("change", () => updateInputType(columnSelect, operatorSelect, valueInput));
                updateOperatorOptions(columnSelect, operatorSelect);
                updateInputType(columnSelect, operatorSelect, valueInput);

                const removeButton = document.createElement("button");
                removeButton.type = "button";
                removeButton.className = "btn btn-sm btn-outline-secondary filter-remove-button";
                removeButton.dataset.removeAreteFilter = "";
                removeButton.textContent = "Valyti";
                row.appendChild(removeButton);
                row.appendChild(help);

                return row;
            }

            function createOption(value, text) {
                const option = document.createElement("option");
                option.value = value;
                option.textContent = text;
                return option;
            }

            function updateInputType(columnSelect, operatorSelect, valueInput) {
                const dataType = columnSelect.selectedOptions[0]?.dataset.type ?? "text";
                const operatorValue = operatorSelect?.value ?? "eq";
                valueInput.type = operatorValue === "in" || operatorValue === "like"
                    ? "text"
                    : dataType === "date" || dataType === "datetime"
                    ? "text"
                        : dataType === "int" || dataType === "decimal"
                            ? "number"
                            : "text";
                valueInput.inputMode = dataType === "int"
                    ? "numeric"
                    : dataType === "decimal"
                        ? "decimal"
                        : "text";
                valueInput.step = dataType === "decimal" ? "any" : "1";
                valueInput.lang = dataType === "date" || dataType === "datetime" ? "en-CA" : "";
                valueInput.removeAttribute("pattern");
                valueInput.placeholder = dataType === "date" ? "YYYY-MM-DD" : "Reiksme";
                wireIsoDatePicker(valueInput, dataType);
                const help = valueInput.closest(".exchange-filter-row")?.querySelector("[data-arete-filter-description]");
                if (help) {
                    help.textContent = columnSelect.selectedOptions[0]?.dataset.description || "";
                }
            }

            function getOperatorText(value) {
                return value === "eq"
                    ? "="
                    : value === "ne"
                        ? "!="
                        : value === "like"
                            ? "LIKE"
                            : value === "in"
                                ? "IN"
                                : value === "gte"
                                    ? ">="
                                    : value === "lte"
                                        ? "<="
                                : value;
            }

            function updateOperatorOptions(columnSelect, operatorSelect) {
                if (!operatorSelect) {
                    return;
                }

                const currentValue = operatorSelect.value;
                const operators = (columnSelect.selectedOptions[0]?.dataset.operators ?? "eq")
                    .split(",")
                    .map(operator => operator.trim())
                    .filter(Boolean);

                operatorSelect.replaceChildren();
                operators.forEach(operator => operatorSelect.appendChild(createOption(operator, getOperatorText(operator))));

                if (operators.includes(currentValue)) {
                    operatorSelect.value = currentValue;
                }
            }

            document.querySelectorAll("[data-arete-filter-column], select[name='FilterColumns']").forEach(columnSelect => {
                const row = columnSelect.closest(".exchange-filter-row");
                const valueInput = row?.querySelector("input[name='FilterValues']");
                const operatorSelect = row?.querySelector("select[name='FilterOperators']");
                if (!valueInput) {
                    return;
                }

                columnSelect.addEventListener("change", () => {
                    updateOperatorOptions(columnSelect, operatorSelect);
                    updateInputType(columnSelect, operatorSelect, valueInput);
                });
                operatorSelect?.addEventListener("change", () => updateInputType(columnSelect, operatorSelect, valueInput));
                updateOperatorOptions(columnSelect, operatorSelect);
                updateInputType(columnSelect, operatorSelect, valueInput);
            });

            document.querySelectorAll("input[data-arete-filter-type]").forEach(valueInput => {
                const row = valueInput.closest(".exchange-filter-row");
                const operatorSelect = row?.querySelector("select[name='FilterOperators']");
                const updateLockedInput = () => {
                    const dataType = valueInput.dataset.areteFilterType ?? "text";
                    const operatorValue = operatorSelect?.value ?? "eq";
                    valueInput.type = operatorValue === "in" || operatorValue === "like"
                        ? "text"
                        : dataType === "date" || dataType === "datetime"
                            ? "text"
                                : dataType === "int" || dataType === "decimal"
                                    ? "number"
                                    : "text";
                    valueInput.inputMode = dataType === "int"
                        ? "numeric"
                        : dataType === "decimal"
                            ? "decimal"
                            : "text";
                    valueInput.step = dataType === "decimal" ? "any" : "1";
                    valueInput.lang = dataType === "date" || dataType === "datetime" ? "en-CA" : "";
                    valueInput.removeAttribute("pattern");
                    valueInput.placeholder = dataType === "date" ? "YYYY-MM-DD" : "Reiksme";
                    wireIsoDatePicker(valueInput, dataType);
                };

                operatorSelect?.addEventListener("change", updateLockedInput);
                updateLockedInput();
            });

            function wireIsoDatePicker(valueInput, dataType) {
                if (dataType !== "date" && dataType !== "datetime") {
                    valueInput.dataset.isoDatePicker = "";
                    return;
                }

                if (valueInput.dataset.isoDatePicker === dataType) {
                    return;
                }

                valueInput.dataset.isoDatePicker = dataType;
                valueInput.addEventListener("focus", () => openIsoDatePicker(valueInput, dataType));
                valueInput.addEventListener("click", () => openIsoDatePicker(valueInput, dataType));
                valueInput.addEventListener("blur", () => {
                    valueInput.type = "text";
                });
            }

            function openIsoDatePicker(valueInput, dataType) {
                if (valueInput.type === "date" || valueInput.type === "datetime-local") {
                    return;
                }

                valueInput.type = dataType === "date" ? "date" : "datetime-local";
                if (typeof valueInput.showPicker === "function") {
                    valueInput.showPicker();
                }
            }
        })();
    </script>
}



















