@section Scripts {
    <script>
        (() => {
            const table = document.getElementById("promoForecastTable");
            const saveButton = document.getElementById("promoForecastSaveButton");
            const status = document.getElementById("promoForecastUpdateStatus");
            const changedRows = {};

            if (!table || !saveButton) {
                return;
            }

            table.querySelectorAll("td[data-editable='true']").forEach((cell) => {
                cell.addEventListener("dblclick", () => makeEditable(cell));
            });

            saveButton.addEventListener("click", sendUpdates);
            const filterRows = document.getElementById("promoForecastFilterRows");
            const addFilterButton = document.getElementById("promoForecastAddFilterButton");
            addFilterButton?.addEventListener("click", () => {
                const row = createPromoFilterRow();
                filterRows?.appendChild(row);
                normalizePromoFilterConnectors();
            });
            filterRows?.addEventListener("click", (event) => {
                const button = event.target.closest("[data-promo-remove-filter]");
                if (!button) {
                    return;
                }

                const row = button.closest(".exchange-filter-row");
                const rows = filterRows.querySelectorAll(".exchange-filter-row");
                if (rows.length <= 1) {
                    row.querySelector("select[name='FilterColumns']").value = "";
                    row.querySelector("select[name='FilterOperators']").value = "eq";
                    row.querySelector("input[name='FilterValues']").value = "";
                    normalizePromoFilterConnectors();
                    return;
                }

                row.remove();
                normalizePromoFilterConnectors();
            });

            function createPromoFilterRow() {
                const first = filterRows?.querySelector(".exchange-filter-row");
                const row = first.cloneNode(true);
                row.querySelector("select[name='FilterColumns']").value = "";
                row.querySelector("select[name='FilterOperators']").value = "eq";
                row.querySelector("input[name='FilterValues']").value = "";
                return row;
            }

            function normalizePromoFilterConnectors() {
                filterRows?.querySelectorAll(".exchange-filter-row").forEach((row, index) => {
                    const slot = row.querySelector(".filter-connector");
                    if (!slot) {
                        return;
                    }

                    if (index === 0) {
                        slot.innerHTML = '<span class="filter-connector-placeholder">WHERE</span><input type="hidden" name="FilterConnectors" value="and" />';
                        return;
                    }

                    const selected = slot.querySelector("select")?.value || "and";
                    slot.innerHTML = '<select name="FilterConnectors" class="form-select form-select-sm" aria-label="Filtro jungiklis"><option value="and">AND</option><option value="or">OR</option></select>';
                    slot.querySelector("select").value = selected === "or" ? "or" : "and";
                });
            }

            normalizePromoFilterConnectors();
            function makeEditable(cell) {
                if (cell.querySelector("input")) {
                    return;
                }

                const originalValue = cell.textContent.trim();
                const columnName = cell.dataset.columnName;
                const rowKey = cell.closest("tr")?.dataset.rowKey;
                if (!columnName || !rowKey) {
                    return;
                }

                const input = document.createElement("input");
                input.type = "text";
                input.className = "form-control form-control-sm";
                input.value = originalValue;
                input.addEventListener("blur", () => saveCell(input, rowKey, columnName));
                input.addEventListener("keydown", (event) => {
                    if (event.key === "Enter") {
                        event.preventDefault();
                        input.blur();
                    }
                    if (event.key === "Escape") {
                        event.preventDefault();
                        cell.textContent = originalValue;
                    }
                });

                cell.textContent = "";
                cell.appendChild(input);
                input.focus();
            }

            function saveCell(input, rowKey, columnName) {
                const cell = input.parentElement;
                const newValue = input.value;
                cell.textContent = newValue;
                changedRows[rowKey] ??= {};
                changedRows[rowKey][columnName] = newValue;
                cell.closest("tr").style.backgroundColor = "#f0f0f0";
                saveButton.style.display = "inline-block";
                if (status) {
                    status.textContent = "Yra neissaugotu pakeitimu.";
                }
            }

            async function sendUpdates() {
                const token = document.querySelector("input[name='__RequestVerificationToken']")?.value ?? "";
                const response = await fetch("?handler=UpdatePromoForecastRows", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": token
                    },
                    body: JSON.stringify({
                        tableName: "BLS_LOGIT_STAT.dbo.KAIROS_PROMO_FORECAST",
                        updates: changedRows
                    })
                });

                if (response.ok) {
                    if (status) {
                        status.textContent = "Pakeitimai issaugoti.";
                    }
                    window.location.href = "#kairos-promo-forecast";
                    window.location.reload();
                    return;
                }

                const message = await response.text();
                if (status) {
                    status.textContent = message || "Pakeitimu issaugoti nepavyko.";
                }
            }
        })();
    </script>
